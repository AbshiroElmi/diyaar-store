# ─────────────────────────────────────────────────────────────
#  Diyaar Portal — environment settings
#  Copy this file to `.env` and change the values you need.
#  Only variables that start with VITE_ are sent to the browser.
#  Never put secrets (API secrets, passwords) in VITE_ variables.
# ─────────────────────────────────────────────────────────────

# App
VITE_APP_NAME="Diyaar Portal"
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US

# Diyaar backend. The phone app calls it directly; in the browser the dev server proxies /api to it.
VITE_API_BASE_URL=https://diyaar-app.easytouch.cloud

# Store-portal endpoints (the same ones the Diyaar web admin panel uses)
VITE_API_METHOD_PATH=/api/method/diyaar_backend.admin_api

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=20000

# ── Dev server only (not sent to the browser) ──
PORTAL_DEV_PORT=8090
# Where the dev server forwards /api and /files (defaults to VITE_API_BASE_URL's server), e.g. http://localhost:8000
# thismy local http://127.0.0.1:8001/
PORTAL_DEV_PROXY_TARGET=
