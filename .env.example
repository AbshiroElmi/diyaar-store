# ─────────────────────────────────────────────────────────────
#  Diyaar Portal — environment settings
#  Copy this file to `.env` and change the values you need.
#  Only variables that start with VITE_ are sent to the browser.
#  Never put secrets (API secrets, passwords) in VITE_ variables.
# ─────────────────────────────────────────────────────────────

# App
VITE_APP_NAME="Diyaar Portal"
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US

# API mode
#   mock  → uses the built-in mock API (no backend needed)
#   live  → calls the real Diyaar (Frappe) backend
VITE_API_MODE=mock

# Backend URL used in live mode.
# Web: leave empty to call the same origin (works with the dev proxy below).
# iOS / Android app: MUST be the full backend URL, e.g. https://api.diyaar.so
VITE_API_BASE_URL=

# Frappe module path for the store-owner endpoints
VITE_API_METHOD_PATH=/api/method/diyaar_backend.api.stores.self_service

# Request timeout in milliseconds
VITE_API_TIMEOUT_MS=20000

# Mock API: fake network delay in milliseconds (makes loading states visible)
VITE_MOCK_LATENCY_MS=350

# ── Dev server only (not sent to the browser) ──
PORTAL_DEV_PORT=8090
# Forward /api/* to your local Frappe bench in live mode, e.g. http://localhost:8000
# thismy local http://127.0.0.1:8001/
PORTAL_DEV_PROXY_TARGET=
